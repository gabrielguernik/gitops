  "timezone": "utc",
  "editable": false,
  "schemaVersion": 41,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "1m",
  "graphTooltip": 1,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "AWS dependencies",
      "type": "link",
      "url": "/d/aws-dependencies",
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "row",
      "title": "Is it the API? (alerts: ALB 5xx ratio > 5% for 5m, p95 > 500 ms for 10m)",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Requests/s",
      "description": "User requests the API served (no probes).",
      "datasource": {
        "type": "grafana-amazonprometheus-datasource",
        "uid": "amp"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-amazonprometheus-datasource",
            "uid": "amp"
          },
          "expr": "sum(rate(http_request_duration_seconds_count{service=\"realworld-api\", route!~\"/healthz|/readyz|/metrics\"}[$__rate_interval]))",
          "legendFormat": "",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 5,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "5xx ratio at the ALB (what users see)",
      "description": "Last 5 minutes, from CloudWatch (1-2 min behind). Includes the 503s the ALB answers itself when no pod is ready. The error alert uses this.",
      "datasource": {
        "type": "grafana-amazonprometheus-datasource",
        "uid": "amp"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-amazonprometheus-datasource",
            "uid": "amp"
          },
          "expr": "((sum(sum_over_time(aws_applicationelb_httpcode_elb_5_xx_count_sum[5m])) or vector(0)) + (sum(sum_over_time(aws_applicationelb_httpcode_target_5_xx_count_sum[5m])) or vector(0))) / (sum(sum_over_time(aws_applicationelb_request_count_sum[5m])) + (sum(sum_over_time(aws_applicationelb_httpcode_elb_5_xx_count_sum[5m])) or vector(0)))",
          "legendFormat": "",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 3,
      "gridPos": {
        "x": 5,
        "y": 1,
        "w": 5,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "5xx ratio in the API",
      "description": "Errors the API itself returned. ALB errors without API errors: no pod is ready.",
      "datasource": {
        "type": "grafana-amazonprometheus-datasource",
        "uid": "amp"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-amazonprometheus-datasource",
            "uid": "amp"
          },
          "expr": "(sum(rate(http_request_duration_seconds_count{service=\"realworld-api\", route!~\"/healthz|/readyz|/metrics\", status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_request_duration_seconds_count{service=\"realworld-api\", route!~\"/healthz|/readyz|/metrics\"}[$__rate_interval]))",
          "legendFormat": "",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
