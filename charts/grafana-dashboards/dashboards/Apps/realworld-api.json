    {
      "type": "timeseries",
      "title": "Cache hit ratio by cache",
      "description": "A cold or failing cache sends every read to PostgreSQL. result=error means Valkey is unreachable.",
      "datasource": {
        "type": "grafana-amazonprometheus-datasource",
        "uid": "amp"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-amazonprometheus-datasource",
            "uid": "amp"
          },
          "expr": "(sum by (cache) (rate(cache_requests_total{service=\"realworld-api\", result=\"hit\"}[$__rate_interval])) or 0 * sum by (cache) (rate(cache_requests_total{service=\"realworld-api\"}[$__rate_interval]))) / sum by (cache) (rate(cache_requests_total{service=\"realworld-api\"}[$__rate_interval]))",
          "legendFormat": "{{cache}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
