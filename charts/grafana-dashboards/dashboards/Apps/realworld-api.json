    {
      "type": "timeseries",
      "title": "Load balancer: requests and 5xx per minute",
      "description": "CloudWatch, per minute, copied into AMP by Alloy.",
      "datasource": {
        "type": "grafana-amazonprometheus-datasource",
        "uid": "amp"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-amazonprometheus-datasource",
            "uid": "amp"
          },
          "expr": "sum(aws_applicationelb_request_count_sum)",
          "legendFormat": "requests",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-amazonprometheus-datasource",
            "uid": "amp"
          },
          "expr": "sum(aws_applicationelb_httpcode_elb_5_xx_count_sum)",
          "legendFormat": "5xx from the ALB (no ready pod, timeouts)",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "datasource": {
            "type": "grafana-amazonprometheus-datasource",
            "uid": "amp"
          },
          "expr": "sum(aws_applicationelb_httpcode_target_5_xx_count_sum)",
          "legendFormat": "5xx from the API",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7,
